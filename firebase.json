{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "google-apps-script/**"],
    "headers": [
      {"source": "**/*.@(png|jpg|mp3|woff2)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000"}]},
      {"source": "**/*.@(js|css|html)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  }
}
